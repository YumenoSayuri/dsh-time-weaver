{
  "name": "@local/dsh-time-weaver",
  "version": "1.0.8",
  "description": "时空编织者 (Time Weaver) — 全能会话流控制：用户消息回溯重填、AI 回复原地编辑、语义占位撤回删除、保全工具链的时空回退重新生成。",
  "type": "module",
  "main": "host.v8.js",
  "exports": {
    ".": "./host.v8.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.v8.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "meta": {
    "title": "时空编织者 (Time Weaver)",
    "description": "全能会话流控制：用户消息回退重填、AI 回复原地编辑、语义占位撤回/删除、保全工具链的时空回退重新生成。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "rewind",
    "time-weaver"
  ],
  "author": "Nova & 辉宝主人 (Based on @xsj/dsh-rewind by XSJUSTC)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YumenoSayuri/dsh-time-weaver.git"
  },
  "homepage": "https://github.com/YumenoSayuri/dsh-time-weaver#readme",
  "bugs": {
    "url": "https://github.com/YumenoSayuri/dsh-time-weaver/issues"
  }
}
